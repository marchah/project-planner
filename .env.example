# Copy to .env and adjust. NEVER commit .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
# SQLite by default (a libsql file: URL).
DATABASE_URL=file:./data/app.db
# Optional: an OpenAI-compatible endpoint that titles new ideas. Unset: ideas stay untitled.
# TITLE_MODEL_BASE_URL=http://localhost:1234/v1
# TITLE_MODEL=            # only if the server needs a model name
# TITLE_MODEL_API_KEY=    # only if the server needs a key
# Optional: base URL for links returned by the REST API. Defaults to the caller's Host header.
# PUBLIC_URL=http://localhost:4000
