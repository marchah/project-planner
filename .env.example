# Copy to .env and adjust. NEVER commit .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
# SQLite by default (a libsql file: URL).
DATABASE_URL=file:./data/app.db
# Optional: an OpenAI-compatible endpoint that titles new ideas. Unset: ideas stay untitled.
# TITLE_MODEL_BASE_URL=http://localhost:1234/v1
# TITLE_MODEL=            # only if the server needs a model name
# TITLE_MODEL_API_KEY=    # only if the server needs a key
# Optional: Hermes Agent's API, which researches ideas. Unset: research is off.
# HERMES_API_URL=http://localhost:8642
# HERMES_API_KEY=
# HERMES_PROVIDER=        # e.g. openai-codex; unset uses Hermes' default
# RESEARCH_ON_CAPTURE=false
# RESEARCH_CONTEXT=       # free text about you, added to every research prompt
# Optional: base URL for links returned by the REST API. Defaults to the caller's Host header.
# PUBLIC_URL=http://localhost:4000
