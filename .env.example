# Copy to .env and adjust. NEVER commit .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
# SQLite by default (a libsql file: URL).
DATABASE_URL=file:./data/app.db
# Optional: an OpenAI-compatible endpoint that writes titles for new ideas. Unset: ideas stay untitled.
# TITLE_MODEL_BASE_URL=http://192.168.1.57:1234/v1
# Optional: base URL for links returned by the REST API. Defaults to the caller's Host header.
# PUBLIC_URL=http://docker-host:4200
